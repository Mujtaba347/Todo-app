# Copy this file to ".env" (in this folder) and fill in your values.

# ---- Database (PostgreSQL) ----
# Used when you run the backend directly on your machine.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/todo_app

# ---- Security ----
# Use a long random string (32+ chars), e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI assistant (OpenRouter) ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Must be a model that supports tool/function calling, e.g.
#   openai/gpt-4o-mini, anthropic/claude-sonnet-4.5, google/gemini-2.5-flash
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Default admin account (created on first start if no admin exists) ----
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ---- Admin chatbot ----
# false: its run_sql tool is read-only (it can still create/update/delete through the CRUD tools)
# true : run_sql may also run INSERT / UPDATE / DELETE / DDL  (full, unrestricted database access)
ADMIN_BOT_ALLOW_SQL_WRITE=false

# ---- Guardrails (all optional; defaults shown) ----
# Set to "production" on Render: the backend then refuses to start with a weak SECRET_KEY / default admin password.
APP_ENV=development
# false = nobody can self-register; only admins create accounts (admin console or admin chatbot)
ALLOW_REGISTRATION=true
CHAT_PER_MINUTE=10
CHAT_DAILY_LIMIT_USER=50
CHAT_DAILY_LIMIT_ADMIN=200
MAX_TOOL_CALLS_PER_MESSAGE=10
MAX_TODOS_PER_USER=500
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
REGISTER_PER_HOUR_PER_IP=10
SQL_STATEMENT_TIMEOUT_MS=5000
